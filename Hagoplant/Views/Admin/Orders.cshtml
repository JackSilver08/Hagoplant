                                                                // Chá»‰ cho phÃ©p chuyá»ƒn tráº¡ng thÃ¡i theo Ä‘Ãºng State Machine
                                                                bool canTrans = OrderStatuses.CanTransition(o.Status, ns);
                                                                if(canTrans) {
                                                                    <option value="@ns">Chuyá»ƒn sang: @OrderStatuses.GetDisplayName(ns)</option>
                                                                } else {
                                                                    <option value="@ns" disabled>(KhÃ´ng há»£p lá»‡) @OrderStatuses.GetDisplayName(ns)</option>
                                                                }
                                                            }
                                                        }
                                                    </select>
                                                </div>

                                                <div class="mb-3 cancel-reason-group d-none" id="cancel-reason-@o.Id">
                                                    <label class="form-label fw-bold text-danger">LÃ½ do Há»¦Y ÄÆ N HÃ€NG (Báº¯t buá»™c khi Há»¦Y)</label>
                                                    <textarea class="form-control" name="CancelReason" rows="2" placeholder="Nháº­p lÃ½ do há»§y Ä‘Æ¡n cho khÃ¡ch hÃ ng..."></textarea>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label fw-bold text-muted">Ghi chÃº ná»™i bá»™ Admin (TÃ¹y chá»n)</label>
                                                    <textarea class="form-control" name="AdminNotes" rows="2" placeholder="Ghi chÃº thÃªm vá» Ä‘Æ¡n hÃ ng (khÃ´ng hiá»ƒn thá»‹ cho khÃ¡ch)..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ÄÃ³ng</button>
                                                <button type="submit" class="btn btn-primary-custom"><i class="fas fa-save me-1"></i> LÆ°u thay Ä‘á»•i</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </tbody>
            </table>
