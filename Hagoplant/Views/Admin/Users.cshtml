@model Hagoplant.ViewModels.AdminUserListVm
@using Hagoplant.Models
@using System.Security.Claims

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Người Dùng";

    var currentUserIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    Guid.TryParse(currentUserIdStr, out var currentUserId);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary-custom mb-0"><i class="fas fa-users me-2"></i>Quản lý Người Dùng</h2>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="admin-card mb-4" style="border:none; box-shadow:0 3px 10px rgba(0,0,0,0.05);">
    <div class="card-body">
        <form method="get" action="/Admin/Users" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small mb-1">Tìm theo Tên hoặc Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                    <input type="text" name="search" class="form-control" value="@Model.SearchQuery" placeholder="Nhập từ khóa...">
                </div>
            </div>
            
            <div class="col-md-3">
                <label class="form-label text-muted small mb-1">Phân quyền</label>
                <select name="role" class="form-select">
                    <option value="">Tất cả vai trò</option>
                    @foreach (var r in UserRoles.AllRoles)
                    {
                        var sIf = (Model.RoleFilter == r) ? "selected" : "";
                        @* Cần dùng @Html.Raw để bind thuộc tính selected nếu lồng loop Razor *@
                        if(Model.RoleFilter == r) {
                            <option value="@r" selected>@r</option>
                        } else {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small mb-1">Trạng thái (IsActive)</label>
                <select name="isActive" class="form-select">
                    <option value="" selected="@(Model.IsActiveFilter == null ? "selected" : null)">Tất cả trạng thái</option>
                    <option value="true" selected="@(Model.IsActiveFilter == true ? "selected" : null)">Đang hoạt động</option>
                    <option value="false" selected="@(Model.IsActiveFilter == false ? "selected" : null)">Đã bị vô hiệu hóa</option>
                </select>
            </div>

            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary-custom"><i class="fas fa-filter me-1"></i> Lọc dữ liệu</button>
            </div>
        </form>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Tổng: @Model.TotalCount người dùng</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Khách hàng</th>
                        <th>Vai trò</th>
                        <th>Bảo mật</th>
                        <th>Mốc thời gian</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Users == null || Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state py-5">
                                    <i class="fas fa-user-slash text-muted" style="font-size:3rem"></i>
                                    <p class="mt-3 text-muted">Không tìm thấy người dùng nào khớp với bộ lọc</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Users)
                        {
                            var isSelf = (currentUserId != Guid.Empty && u.Id == currentUserId);
                            var isLocked = u.IsLockedOut;
                            
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(u.FullName) ? "- Không Rõ Tên -" : u.FullName)</div>
                                    <div class="text-muted small">@u.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(u.Phone))
                                    {
                                        <div class="text-muted small"><i class="fas fa-phone-alt me-1" style="font-size:10px"></i> @u.Phone</div>
                                    }
                                </td>
                                
                                <td>
                                    @if(u.Role == UserRoles.Admin){
                                        <span class="badge bg-danger"><i class="fas fa-user-shield me-1"></i> ADMIN</span>
                                    } 
                                    else {
                                        <span class="badge bg-secondary text-white">@u.Role</span>
                                    }
                                </td>

                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success mb-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger mb-1">Deactivated</span>
                                    }

                                    @if (isLocked)
                                    {
                                        <div class="small mt-1 text-danger">
                                            <i class="fas fa-lock me-1"></i> Khóa tới: @(u.LockedUntil?.ToLocalTime().ToString("HH:mm dd/MM")) 
                                        </div>
                                    }
                                    @if (u.FailedLoginAttempts > 0)
                                    {
                                        <div class="small text-warning"><i class="fas fa-exclamation-triangle me-1"></i> @u.FailedLoginAttempts lần sai pass</div>
                                    }
                                </td>

                                <td class="text-muted small">
                                    Mới: @u.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br/>
                                    Cập nhật: @u.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" @(isSelf ? "disabled" : "")>
                                            <i class="fas fa-cog"></i> H.Động
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            
                                            <!-- Thay đổi Role -->
                                            <li><h6 class="dropdown-header">Thay đổi quyền</h6></li>
                                            @foreach (var r in UserRoles.AllRoles)
                                            {
                                                if (u.Role != r)
                                                {
                                                    <li>
                                                        <form method="post" action="/Admin/ChangeUserRole">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@u.Id" />
                                                            <input type="hidden" name="newRole" value="@r" />
                                                            <button type="submit" class="dropdown-item py-2" onclick="return confirm('Chuyển @u.Email sang Role @r?');">
                                                                <i class="fas fa-user-tag me-2 text-muted"></i> Nâng/hạ quyền @r
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            }
                                            
                                            <li><hr class="dropdown-divider"></li>

                                            <!-- Vô hiệu hóa/Kích hoạt -->
                                            <li>
                                                <form method="post" action="/Admin/ToggleUserActive">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="dropdown-item py-2 @(u.IsActive ? "text-danger" : "text-success")">
                                                        <i class="fas @(u.IsActive ? "fa-ban" : "fa-check-circle") me-2"></i> @(u.IsActive ? "Vô hiệu hóa tài khoản" : "Mở khóa tài khoản")
                                                    </button>
                                                </form>
                                            </li>

                                            <!-- Xóa hoàn toàn (nguy hiểm) -->
                                            <li>
                                                <form method="post" action="/Admin/DeleteUser">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="dropdown-item text-danger py-2" onclick="return confirm('CẢNH BÁO: Xóa VĨNH VIỄN người dùng này? Sẽ gây lỗi nếu user đã có đơn hàng/log.');">
                                                        <i class="fas fa-trash-alt me-2"></i> Xóa vĩnh viễn (Nguy hiểm)
                                                    </button>
                                                </form>
                                            </li>

                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.Page - 1)&search=@Model.SearchQuery&role=@Model.RoleFilter&isActive=@Model.IsActiveFilter"><i class="fas fa-chevron-left"></i></a>
            </li>
            
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link @(i == Model.Page ? "bg-primary-custom border-0" : "text-dark")" href="?page=@i&search=@Model.SearchQuery&role=@Model.RoleFilter&isActive=@Model.IsActiveFilter">@i</a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.Page + 1)&search=@Model.SearchQuery&role=@Model.RoleFilter&isActive=@Model.IsActiveFilter"><i class="fas fa-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
