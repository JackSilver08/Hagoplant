<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Hago Tree Admin</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    @RenderSection("Styles", required: false)
</head>
<body class="admin-layout">

    <header class="admin-header d-flex align-items-center px-4">
        <a href="/Admin/Index" class="text-decoration-none d-flex align-items-center">
            <img class="footerlogo me-3" src="~/images/HagoGreen.png" alt="Logo" />
            <h4 class="brand-text text-dark mb-0 ms-1 admin-brand-title">HAGO TREE</h4>
            <span class="badge bg-primary-custom ms-3 px-2 py-1 small rounded-pill">Quáº£n trá»‹</span>
        </a>
        <div class="ms-auto d-flex align-items-center">
            <a href="/" class="btn btn-sm btn-outline-secondary me-3"><i class="fas fa-external-link-alt me-1"></i>Trang chá»§</a>
            <form method="post" action="/Account/Logout" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-danger px-3"><i class="fas fa-sign-out-alt me-1"></i> ÄÄƒng xuáº¥t</button>
            </form>
        </div>
    </header>

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            @{
                var currentUrl = Context.Request.Path.Value?.ToLower() ?? "";
            }
            <div class="col-lg-2 col-md-3 bg-white">
                <div class="admin-sidebar p-3">
                    <div class="text-xs font-weight-bold text-uppercase text-muted mb-3 px-2 admin-sidebar-heading">MENU CHÃNH</div>
                    <ul class="nav flex-column mb-4">
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.EndsWith("/admin") || currentUrl.EndsWith("/admin/index") ? "active" : "")" href="/Admin/Index#dashboard">
                                <i class="fas fa-chart-line"></i> Tá»•ng quan
                            </a>
                        </li>
                    </ul>
                    <div class="text-xs font-weight-bold text-uppercase text-muted mb-3 px-2 admin-sidebar-heading">QUáº¢N LÃ Dá»® LIá»†U</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.Contains("/users") ? "active" : "")" href="/Admin/Users">
                                <i class="fas fa-users-cog"></i> NgÆ°á»i dÃ¹ng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.Contains("/orders") ? "active" : "")" href="/Admin/Orders">
                                <i class="fas fa-shopping-bag"></i> ÄÆ¡n hÃ ng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Index#products">
                                <i class="fas fa-leaf"></i> Sáº£n pháº©m
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Admin/Index#blog">
                                <i class="fas fa-newspaper"></i> Blog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentUrl.Contains("/auditlogs") ? "active" : "")" href="/Admin/AuditLogs">
                                <i class="fas fa-shield-alt"></i> Nháº­t kÃ½ há»‡ thá»‘ng
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-10 col-md-9 pt-2">
                <div class="admin-content">
                    <!-- Toast thÃ´ng bÃ¡o -->
                    @if (TempData["Toast.Message"] != null)
                    {
                        var isOk = (string)TempData["Toast.Ok"] == "1";
                        <div class="alert alert-@(isOk ? "success" : "danger") alert-dismissible fade show shadow-sm @(isOk ? "admin-alert-success" : "admin-alert-danger")" role="alert">
                            <i class="fas @(isOk ? "fa-check-circle" : "fa-exclamation-circle") me-2"></i>
                            @TempData["Toast.Message"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>


