    <!-- Các script khác của bạn -->
    <script>
        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                var hr = this.getAttribute('href');
                if(hr && hr !== '#' && hr !== '#!') {
                    var el = document.querySelector(hr);
                    if(el) {
                        e.preventDefault();
                        el.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            });
        });

        // =========================
        // CART: Fly-to-cart animation + tăng badge sau khi bay xong
        // =========================
            document.addEventListener('DOMContentLoaded', () => {
        const cartBtn = document.getElementById('cart-btn');
        const badgeEl = document.querySelector('.cart-badge');
        if (!cartBtn || !badgeEl) return;

        let cartCount = parseInt((badgeEl.textContent || '0').trim(), 10);
        if (Number.isNaN(cartCount) || cartCount < 0) cartCount = 0;
        badgeEl.textContent = cartCount;

        function setCartCount(n) {
          cartCount = n;
          badgeEl.textContent = cartCount;
        }

        function bumpCart() {
          cartBtn.classList.add('cart-bump');
          setTimeout(() => cartBtn.classList.remove('cart-bump'), 350);
        }

          function flyToCart(clickedBtn) {
          return new Promise((resolve) => {
            // Nếu user bật reduced motion → bỏ animation
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              resolve();
              return;
            }

            const card = clickedBtn.closest('.product-card') || clickedBtn.closest('.home-product-item');
            const img = card ? card.querySelector('img') : null;
            if (!img) { resolve(); return; }

            // Target bay vào icon (nếu có), fallback về cả nút giỏ
            const cartTarget = cartBtn.querySelector('i') || cartBtn;

            const imgRect = img.getBoundingClientRect();
            const cartRect = cartTarget.getBoundingClientRect();

            // Nếu rect lỗi (hiếm) → resolve
            if (imgRect.width === 0 || imgRect.height === 0) { resolve(); return; }

            const clone = img.cloneNode(true);
            clone.style.position = 'fixed';
            clone.style.left = imgRect.left + 'px';
            clone.style.top = imgRect.top + 'px';
            clone.style.width = imgRect.width + 'px';
            clone.style.height = imgRect.height + 'px';
            clone.style.objectFit = 'cover';
            clone.style.borderRadius = '12px';
            clone.style.display = 'block';
            clone.style.zIndex = '5000';
            clone.style.pointerEvents = 'none';
            clone.style.opacity = '1';
            clone.style.transform = 'translate3d(0,0,0) scale(1)';
            clone.style.willChange = 'transform, opacity';
            clone.style.boxShadow = '0 18px 40px rgba(0,0,0,.18)';

            document.body.appendChild(clone);

            // FORCE REFLOW: cực quan trọng để đảm bảo transition “ăn”
            // (nếu không, nhiều browser sẽ gộp thay đổi và bạn không thấy animation)
            void clone.getBoundingClientRect();

            const startX = imgRect.left + imgRect.width / 2;
            const startY = imgRect.top + imgRect.height / 2;
            const endX = cartRect.left + cartRect.width / 2;
            const endY = cartRect.top + cartRect.height / 2;

            const dx = endX - startX;
            const dy = endY - startY;

            // Transition sau khi đã reflow
            clone.style.transition = 'transform 700ms cubic-bezier(.2,.8,.2,1), opacity 700ms ease';

            requestAnimationFrame(() => {
              clone.style.transform = `translate3d(${dx}px, ${dy}px, 0) scale(0.12)`;
              clone.style.opacity = '0.2';
            });

            const done = () => {
              clone.remove();
              resolve();
            };

            clone.addEventListener('transitionend', done, { once: true });
            setTimeout(done, 900); // fallback
          });
        }


          // Bind nút add-to-cart
                 document.querySelectorAll('.add-cart-form').forEach((form) => {
            form.addEventListener('submit', async (e) => {
              e.preventDefault();

              const btn = form.querySelector('button[type="submit"]');
              if (!btn) return;

              if (btn.dataset.busy === '1') return;
              btn.dataset.busy = '1';
              btn.disabled = true;

              try {
                // 1) Bay vào giỏ
                await flyToCart(btn);

                // 2) POST thật lên server để lưu giỏ hàng
                const fd = new FormData(form);

                const res = await fetch(form.action, {
                  method: 'POST',
                  headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                  },
                  body: new URLSearchParams(fd),
                  credentials: 'same-origin'
                });

                if (!res.ok) {
                  // fallback: submit kiểu truyền thống (nếu cần)
                  form.submit();
                  return;
                }

                const data = await res.json();

                // 3) Cập nhật badge theo số lượng thật từ DB
                if (data && data.ok === true) {
                  setCartCount(data.count ?? (cartCount + 1));
                  bumpCart();
                }
              } finally {
                btn.dataset.busy = '0';
                btn.disabled = false;
              }
            });
          });
        });

        // Slider Hero Section
        document.addEventListener('DOMContentLoaded', function() {
            const slides = document.querySelectorAll('.hero-slide');
            const dots = document.querySelectorAll('.dot');
            let currentSlide = 0;
            const slideInterval = 5000;
            function showSlide(index) {
                slides.forEach(slide => slide.classList.remove('active'));
                dots.forEach(dot => dot.classList.remove('active'));
                slides[index].classList.add('active');
                dots[index].classList.add('active');
                currentSlide = index;
            }
            function nextSlide() {
                let nextIndex = (currentSlide + 1) % slides.length;
                showSlide(nextIndex);
            }
            let slideTimer = setInterval(nextSlide, slideInterval);
            dots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    clearInterval(slideTimer);
                    showSlide(index);
                    slideTimer = setInterval(nextSlide, slideInterval);
                });
            });
            const heroSection = document.querySelector('.hero-section');
            heroSection.addEventListener('mouseenter', () => clearInterval(slideTimer));
            heroSection.addEventListener('mouseleave', () => slideTimer = setInterval(nextSlide, slideInterval));
        });

        // Toast
        document.addEventListener('DOMContentLoaded', function () {
            const toast = document.getElementById('hagoToast');
            if (!toast) return;
            const btnClose = document.getElementById('hagoToastClose');
            const bar = document.getElementById('hagoToastProgress');
            const DURATION = 5000;
            const TICK = 50;
            let elapsed = 0;
            function hideToast() {
                toast.style.transition = 'opacity 250ms ease, transform 250ms ease';
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-8px)';
                setTimeout(() => toast.remove(), 260);
            }
            const timer = setInterval(() => {
                elapsed += TICK;
                const remain = Math.max(0, DURATION - elapsed);
                const pct = (remain / DURATION) * 100;
                if (bar) bar.style.width = pct + '%';
                if (elapsed >= DURATION) {
                    clearInterval(timer);
                    hideToast();
                }
            }, TICK);
            btnClose?.addEventListener('click', () => {
                clearInterval(timer);
                hideToast();
            });
        });

        // ==================== SCRIPT OTP EMAILJS CHÍNH ====================
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('registerForm');
            if (!form) return;

            const emailEl = document.getElementById('registerEmail');
            const otpBlock = document.getElementById('otpBlock');
            const otpEl = document.getElementById('registerOtp');
            const alertEl = document.getElementById('registerAlert');
            const btnSendOtp = document.getElementById('btnSendOtp');
            const btnResendOtp = document.getElementById('btnResendOtp');
            const btnVerifyOtp = document.getElementById('btnVerifyOtp');
            const btnSubmit = document.getElementById('btnRegisterSubmit');
            const otpVerifiedEl = document.getElementById('OtpVerified');
            const countdownEl = document.getElementById('otpCountdown');

            let currentOtp = '';
            let countdownTimer = null;
            let remaining = 0;

            function showAlert(type, msg) {
                alertEl.classList.remove('d-none', 'alert-success', 'alert-danger', 'alert-warning', 'alert-info');
                alertEl.classList.add('alert-' + type);
                alertEl.innerHTML = msg;
            }

            function clearAlert() {
                alertEl.classList.add('d-none');
                alertEl.innerHTML = '';
            }

            function setVerified(isVerified) {
                otpVerifiedEl.value = isVerified ? '1' : '0';
                btnSubmit.disabled = !isVerified;
            }

            function startCountdown(seconds) {
                remaining = seconds;
                btnResendOtp.disabled = true;
                countdownEl.textContent = `(${remaining}s)`;
                if (countdownTimer) clearInterval(countdownTimer);
                countdownTimer = setInterval(() => {
                    remaining--;
                    if (remaining <= 0) {
                        clearInterval(countdownTimer);
                        countdownTimer = null;
                        countdownEl.textContent = '';
                        btnResendOtp.disabled = false;
                    } else {
                        countdownEl.textContent = `(${remaining}s)`;
                    }
                }, 1000);
            }

            emailEl.addEventListener('input', () => {
                setVerified(false);
                otpBlock.classList.add('d-none');
                currentOtp = '';
                otpEl.value = '';
                clearAlert();
            });

            btnSendOtp.addEventListener('click', async () => {
                clearAlert();
                setVerified(false);
                const email = emailEl.value.trim();
                if (!email) {
                    showAlert('warning', 'Vui lòng nhập email hợp lệ.');
                    return;
                }

                btnSendOtp.disabled = true;
                btnSendOtp.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...';

                currentOtp = Math.floor(100000 + Math.random() * 900000).toString();

                try {
                    await emailjs.send("service_k5l82mh", "template_auosw4p", {
                        to_email: email,
                        otp: currentOtp
                    });
                            console.log("otpBlock before:", otpBlock?.className);
        otpBlock.classList.remove('d-none');
        console.log("otpBlock after:", otpBlock?.className);
                    otpEl.focus();
                    showAlert('info', 'Mã OTP đã gửi! Kiểm tra email (cả spam).');
                    startCountdown(30);
                } catch (err) {
                    console.error("EmailJS lỗi:", err);
                    showAlert('danger', 'Gửi OTP thất bại. Thử lại sau.');
                } finally {
                    btnSendOtp.disabled = false;
                    btnSendOtp.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i>Gửi OTP';
                }
            });

            btnResendOtp.addEventListener('click', () => btnSendOtp.click());

            btnVerifyOtp.addEventListener('click', () => {
                clearAlert();
                const inputOtp = otpEl.value.trim();
                if (!/^\d{6}$/.test(inputOtp)) {
                    showAlert('warning', 'OTP phải đúng 6 chữ số.');
                    return;
                }
                if (inputOtp === currentOtp) {
                    setVerified(true);
                    showAlert('success', '<i class="fa-solid fa-circle-check me-2"></i>OTP hợp lệ! Bấm Đăng ký được rồi.');
                } else {
                    showAlert('danger', 'OTP sai. Kiểm tra lại nhé.');
                }
            });

            form.addEventListener('submit', e => {
                if (otpVerifiedEl.value !== '1') {
                    e.preventDefault();
                    showAlert('warning', 'Bạn cần xác nhận OTP trước khi đăng ký.');
                }
            });
        });

                document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('homeProductSearch');
            const btn = document.getElementById('homeProductSearchBtn');
            const items = document.querySelectorAll('.home-product-item');
            const noResult = document.getElementById('homeNoResult');
            const productsSection = document.getElementById('products');

            if (!input || !btn || items.length === 0) return;

            function normalize(str) {
                return (str || '')
                    .toString()
                    .trim()
                    .toLowerCase()
                    // bỏ dấu tiếng Việt để tìm "cay" ra "cây"
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '');
            }

            function applyFilter(scrollToProducts) {
                const q = normalize(input.value);
                let visibleCount = 0;

                items.forEach(el => {
                    const id = normalize(el.dataset.id);
                    const name = normalize(el.dataset.name);
                    const slug = normalize(el.dataset.slug);

                    const match = !q || id.includes(q) || name.includes(q) || slug.includes(q);

                    el.classList.toggle('d-none', !match);
                    if (match) visibleCount++;
                });

                if (noResult) noResult.classList.toggle('d-none', visibleCount !== 0);

                if (scrollToProducts && productsSection) {
                    productsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }

            // Realtime filter khi gõ
            input.addEventListener('input', () => applyFilter(false));

            // Click nút search: lọc + cuộn xuống khu vực sản phẩm
            btn.addEventListener('click', () => applyFilter(true));

            // Enter để search (đỡ phải bấm nút)
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    applyFilter(true);
                }
            });
        });
                document.addEventListener('DOMContentLoaded', () => {
            const modalEl = document.getElementById('profileModal');
            const bodyEl = document.getElementById('profileModalBody');
            if (!modalEl || !bodyEl) return;

            // Khi modal mở: gọi server lấy partial view
            modalEl.addEventListener('show.bs.modal', async () => {
                bodyEl.innerHTML = '<div class="py-5 text-center text-muted">Đang tải...</div>';

                try {
                    const res = await fetch('/Account/ProfileModal', {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!res.ok) {
                        bodyEl.innerHTML = `<div class="alert alert-danger mb-0">
                            Không tải được thông tin tài khoản. (HTTP ${res.status})
                        </div>`;
                        return;
                    }

                    const html = await res.text();
                    bodyEl.innerHTML = html;

                    // Sau khi nhét HTML vào modal, mới wire submit form
                    wireProfileForm();
                } catch (err) {
                    console.error('ProfileModal fetch error:', err);
                    bodyEl.innerHTML = `<div class="alert alert-danger mb-0">
                        Lỗi kết nối khi tải thông tin tài khoản.
                    </div>`;
                }
            });

            function wireProfileForm() {
                const form = document.getElementById('profileForm');
                if (!form) return;

                const alertEl = form.querySelector('#profileFormAlert');

                function showAlert(ok, msg) {
                    if (!alertEl) return;
                    alertEl.classList.remove('d-none', 'alert-success', 'alert-danger');
                    alertEl.classList.add(ok ? 'alert-success' : 'alert-danger');
                    alertEl.textContent = msg || (ok ? 'Thành công' : 'Có lỗi xảy ra');
                }

                function clearErrors() {
                    form.querySelectorAll('[data-error-for]').forEach(el => el.textContent = '');
                    if (alertEl) {
                        alertEl.classList.add('d-none');
                        alertEl.textContent = '';
                    }
                }

                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    clearErrors();

                    try {
                        const fd = new FormData(form);
                               const res = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: new URLSearchParams(new FormData(form)),
          credentials: 'same-origin'
        });

        const ct = (res.headers.get('content-type') || '').toLowerCase();

        if (!res.ok) {
          // nếu lỗi thì fallback submit truyền thống để xem lỗi server rõ hơn  
          form.submit();
          return;
        }

        if (!ct.includes('application/json')) {
          // server trả HTML (thường do redirect) -> fallback
          form.submit();
          return;
        }

        const data = await res.json();
        if (data?.ok) {
          setCartCount(data.count ?? (cartCount + 1));
          bumpCart();
        }


                        if (res.ok) {
                            const data = await res.json();
                            showAlert(true, data.message || 'Cập nhật thành công.');

                            // cập nhật tên trên header ngay (nếu muốn)
                            if (data.fullName) {
                                const userDropdown = document.getElementById('userDropdown');
                                if (userDropdown) {
                                    userDropdown.innerHTML = `<i class="fas fa-user me-1"></i> ${data.fullName}`;
                                }
                            }

                            return;
                        }

                        // lỗi validation: backend trả BadRequest JSON
                        let errJson = null;
                        try { errJson = await res.json(); } catch { }

                        showAlert(false, errJson?.message || `Cập nhật thất bại (HTTP ${res.status}).`);

                        if (errJson?.errors) {
                            Object.keys(errJson.errors).forEach(key => {
                                const el = form.querySelector(`[data-error-for="${key}"]`);
                                if (el) el.textContent = errJson.errors[key][0] || '';
                            });
                        }
                    } catch (err) {
                        console.error('UpdateProfile error:', err);
                        showAlert(false, 'Lỗi kết nối khi cập nhật.');
                    }
                });


            }
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ADMIN_EMAIL = 'hagotreevn@gmail.com';

            const modalEl = document.getElementById('loginModal');
            const form = document.getElementById('loginForm');
            if (!modalEl || !form) return;

            const emailEl = document.getElementById('loginEmail');
            const passEl  = document.getElementById('loginPassword');

            const otpArea = document.getElementById('adminOtpArea');
            const otpEl   = document.getElementById('loginOtp');

            const btnSend   = document.getElementById('btnSendAdminOtp');
            const btnResend = document.getElementById('btnResendAdminOtp');
            const countdownEl = document.getElementById('adminOtpCountdown');

            const alertEl = document.getElementById('loginAlert');

            let timer = null;
            let remaining = 0;

            function normalizeEmail(s) {
                return (s || '').trim().toLowerCase();
            }

            function getToken() {
                return form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }

            function showAlert(type, msg) {
                if (!alertEl) return;
                alertEl.classList.remove('d-none', 'alert-success', 'alert-danger', 'alert-warning', 'alert-info');
                alertEl.classList.add('alert-' + type);
                alertEl.textContent = msg;
            }

            function clearAlert() {
                if (!alertEl) return;
                alertEl.classList.add('d-none');
                alertEl.textContent = '';
            }

            function startCountdown(seconds) {
                remaining = seconds;
                btnResend.disabled = true;
                countdownEl.textContent = `(${remaining}s)`;

                if (timer) clearInterval(timer);
                timer = setInterval(() => {
                    remaining--;
                    if (remaining <= 0) {
                        clearInterval(timer);
                        timer = null;
                        countdownEl.textContent = '';
                        btnResend.disabled = false;
                    } else {
                        countdownEl.textContent = `(${remaining}s)`;
                    }
                }, 1000);
            }

            function toggleOtpArea() {
                const isAdmin = normalizeEmail(emailEl.value) === ADMIN_EMAIL;
                otpArea.classList.toggle('d-none', !isAdmin);
                if (!isAdmin) {
                    otpEl.value = '';
                    clearAlert();
                }
            }

            emailEl.addEventListener('input', toggleOtpArea);
            modalEl.addEventListener('shown.bs.modal', toggleOtpArea);

            async function sendAdminOtp() {
                clearAlert();

                const email = normalizeEmail(emailEl.value);
                const password = passEl.value || '';

                if (email !== ADMIN_EMAIL) {
                    showAlert('warning', 'Email này không thuộc admin.');
                    return;
                }
                if (!password) {
                    showAlert('warning', 'Vui lòng nhập mật khẩu trước khi gửi OTP.');
                    return;
                }

                const token = getToken();

                btnSend.disabled = true;
                btnSend.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...';

                try {
                    const res = await fetch('/Account/SendAdminOtp', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        body: new URLSearchParams({
                            email: email,
                            password: password,
                            __RequestVerificationToken: token
                        }),
                        credentials: 'same-origin'
                    });

                    const data = await res.json().catch(() => null);

                    if (!res.ok || !data?.ok) {
                        showAlert('danger', data?.message || `Gửi OTP thất bại (HTTP ${res.status}).`);
                        return;
                    }

                    showAlert('info', data.message || 'OTP đã được gửi về email admin. Kiểm tra hộp thư (cả spam).');
                    startCountdown(30);
                    otpEl.focus();
                } catch (e) {
                    showAlert('danger', 'Lỗi kết nối khi gửi OTP.');
                } finally {
                    btnSend.disabled = false;
                    btnSend.textContent = 'Gửi OTP Admin';
                }
            }

            btnSend?.addEventListener('click', sendAdminOtp);
            btnResend?.addEventListener('click', () => btnSend.click());

            // Chặn submit nếu admin mà OTP chưa đúng định dạng
            form.addEventListener('submit', function (e) {
                const email = normalizeEmail(emailEl.value);
                if (email === ADMIN_EMAIL) {
                    const otp = (otpEl.value || '').trim();
                    if (!/^\d{6}$/.test(otp)) {
                        e.preventDefault();
                        showAlert('warning', 'Vui lòng nhập OTP admin (6 chữ số) trước khi đăng nhập.');
                    }
                }
            });
        });
    </script>

</body>
