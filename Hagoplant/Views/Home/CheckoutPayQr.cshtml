@model Hagoplant.Models.ViewModels.CheckoutPayQrVm

@{
    ViewData["Title"] = "Thanh toán QR";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h4 class="mb-1">Thanh toán QR</h4>
                    <div class="text-muted mb-3">
                        Đơn hàng: <b>@Model.OrderNumber</b>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted">Số tiền cần thanh toán</div>
                        <div class="fs-5 fw-bold">@Model.Amount.ToString("N0") ₫</div>
                    </div>

                    <div class="text-center my-3">
                        <div id="qrBox" class="d-inline-block p-3 border rounded bg-white"></div>
                        <div class="text-muted small mt-2">
                            Dùng app ngân hàng để quét mã QR.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a class="btn btn-success" href="@Model.CheckoutUrl" target="_blank" rel="noopener">
                            Mở trang thanh toán (nếu cần)
                        </a>

                        <a class="btn btn-outline-secondary" href="@Url.Action("Cart", "Home")">
                            Quay lại giỏ hàng
                        </a>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-semibold">Trạng thái</div>
                            <div id="payStatusText" class="text-warning">Đang chờ thanh toán...</div>
                        </div>
                        <div id="spinner" class="spinner-border text-success" role="status" aria-label="loading"></div>
                    </div>

                    <div class="text-muted small mt-3">
                        Lưu ý: Sau khi thanh toán thành công, hệ thống sẽ tự cập nhật trạng thái (có thể mất vài giây).
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
    // 1) Render QR từ payload payOS trả về
    (function renderQr() {
        var el = document.getElementById("qrBox");
        el.innerHTML = "";
        new QRCode(el, {
            text: "@(Model.QrPayload ?? "")",
            width: 240,
            height: 240
        });
    })();

    // 2) Poll trạng thái thanh toán (tùy chọn)
    // Bạn cần tạo endpoint JSON: GET /Home/PaymentStatus?orderId=...
    // Trả về: { paid: true/false, status: "PAID"/"UNPAID"/... }
    const orderId = "@Model.OrderId";
    const statusEl = document.getElementById("payStatusText");
    const spinner = document.getElementById("spinner");

    async function checkStatus() {
        try {
            const res = await fetch("@Url.Action("PaymentStatus", "Home")?orderId=" + encodeURIComponent(orderId), {
                headers: { "Accept": "application/json" }
            });

            if (!res.ok) return;

            const data = await res.json();

           if (data && data.paymentStatus === "PAID") {
    statusEl.classList.remove("text-warning");
    statusEl.classList.add("text-success");
    statusEl.textContent = "Đã thanh toán";
    spinner.classList.add("d-none");
}

        } catch (e) {
            // im lặng - tránh làm phiền người dùng
        }
    }

    // Poll mỗi 3 giây
    setInterval(checkStatus, 3000);
    checkStatus();
</script>
